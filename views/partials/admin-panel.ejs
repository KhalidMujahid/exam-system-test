<section class="animate-fade-in">
  <div class="admin-head">
    <div>
      <span class="page-head-eyebrow">Administration Console</span>
      <h2 class="page-head-title">System Administration</h2>
      <p class="page-head-text">Manage candidate pricing, track configuration, question banks, course materials, and runtime controls from a single workspace.</p>
    </div>
    <form hx-post="/admin/logout" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
      <button class="premium-btn premium-btn-ghost" type="submit">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Lock Session
      </button>
    </form>
  </div>

  <div class="admin-layout">
    <aside class="admin-nav" data-admin-nav aria-label="Admin sections">
      <p class="admin-nav-label">Workspace</p>
      <a class="admin-nav-link is-active" href="#admin-overview">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 13h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6a1 1 0 011-1zM14 3h6a1 1 0 011 1v6a1 1 0 01-1 1h-6a1 1 0 01-1-1V4a1 1 0 011-1zM4 3h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1V4a1 1 0 011-1zM14 13h6a1 1 0 011 1v6a1 1 0 01-1 1h-6a1 1 0 01-1-1v-6a1 1 0 011-1z"/></svg>
        Overview
      </a>
      <a class="admin-nav-link" href="#admin-security">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Security &amp; Duration
      </a>
      <a class="admin-nav-link" href="#admin-pricing">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 10v2m0-2c-1.11 0-2.08-.402-2.599-1"/></svg>
        Tracks &amp; Pricing
      </a>
      <a class="admin-nav-link" href="#admin-materials">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Course Materials
      </a>
      <a class="admin-nav-link" href="#admin-questions">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Question Bank
      </a>
      <a class="admin-nav-link" href="#admin-telemetry">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Telemetry
      </a>
    </aside>

    <div class="admin-content">
      <!-- Overview -->
      <section id="admin-overview" class="admin-section" data-admin-section>
        <div id="admin-stats">
          <%- include("admin-stats", { attemptCounter, examDurationMinutes }) %>
        </div>
      </section>

      <!-- Security & duration -->
      <section id="admin-security" class="admin-section" data-admin-section>
        <div class="grid gap-5 lg:grid-cols-2">
          <div class="card">
            <div class="card-header !mb-4 !pb-4">
              <div>
                <h3 class="card-title">Administrative Password</h3>
                <p class="card-subtitle">Rotate the console password. Minimum 4 characters.</p>
              </div>
            </div>
            <form hx-post="/admin/password" hx-target="#admin-message" hx-swap="innerHTML" hx-indicator="#global-loader">
              <label class="premium-label" for="admin-password">New password</label>
              <div class="flex flex-col gap-3 sm:flex-row">
                <input type="password" id="admin-password" name="password" placeholder="Enter new password" class="premium-input min-w-0 flex-1" />
                <button class="premium-btn premium-btn-primary whitespace-nowrap" type="submit">Update Secret</button>
              </div>
            </form>
            <div id="admin-message" class="mt-4"></div>
          </div>

          <div class="card">
            <div class="card-header !mb-4 !pb-4">
              <div>
                <h3 class="card-title">Global Assessment Duration</h3>
                <p class="card-subtitle">Applies to every assessment session, 1–180 minutes.</p>
              </div>
            </div>
            <form hx-post="/admin/duration" hx-target="#admin-stats" hx-swap="innerHTML" hx-indicator="#global-loader">
              <label class="premium-label" for="exam-duration">Duration (minutes)</label>
              <div class="flex flex-col gap-3 sm:flex-row">
                <input type="number" id="exam-duration" name="minutes" min="1" max="180" value="<%= examDurationMinutes %>" class="premium-input min-w-0 flex-1" />
                <button class="premium-btn premium-btn-secondary whitespace-nowrap" type="submit">Save Duration</button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <!-- Tracks & pricing -->
      <section id="admin-pricing" class="admin-section" data-admin-section>
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Tracks &amp; Pricing</h3>
              <p class="card-subtitle">Cyber security assessments are paid: tick <strong class="text-surface-700">Requires payment</strong> and set a fee in Naira (₦). Leave it unticked for free, standard assessments.</p>
            </div>
            <span class="badge badge-neutral"><%= courses.length %> tracks</span>
          </div>

          <div class="space-y-3">
            <% courses.forEach(function(course) { %>
              <form class="grid gap-3 rounded-xl border border-surface-200 bg-surface-50/60 p-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_140px_170px_auto] lg:items-center" hx-post="/admin/courses" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
                <input type="hidden" name="originalCode" value="<%= course.code %>" />
                <input type="text" name="code" value="<%= course.code %>" class="premium-input font-mono text-xs" aria-label="Course code" />
                <input type="text" name="name" value="<%= course.name %>" class="premium-input" aria-label="Course title" />
                <label class="flex items-center gap-2 text-xs font-semibold text-surface-600 select-none">
                  <input type="checkbox" name="requiresPayment" value="on" <%= course.requiresPayment ? "checked" : "" %> class="premium-radio !mt-0" />
                  Requires payment
                </label>
                <div class="relative min-w-0">
                  <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-surface-400">₦</span>
                  <input type="number" name="priceNaira" min="0" step="0.01" value="<%= (course.priceKobo / 100).toFixed(2) %>" class="premium-input pl-7" aria-label="Assessment fee in naira" />
                </div>
                <button class="premium-btn premium-btn-secondary" type="submit">Save</button>
              </form>
            <% }) %>
          </div>

          <form class="mt-4 grid gap-3 rounded-xl border border-dashed border-surface-300 bg-white p-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_140px_170px_auto] lg:items-center" hx-post="/admin/courses" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
            <input type="text" name="code" placeholder="New course code" class="premium-input font-mono text-xs" />
            <input type="text" name="name" placeholder="New course title" class="premium-input" />
            <label class="flex items-center gap-2 text-xs font-semibold text-surface-600 select-none">
              <input type="checkbox" name="requiresPayment" value="on" class="premium-radio !mt-0" />
              Requires payment
            </label>
            <div class="relative min-w-0">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-surface-400">₦</span>
              <input type="number" name="priceNaira" min="0" step="0.01" placeholder="0.00" class="premium-input pl-7" aria-label="New assessment fee" />
            </div>
            <button class="premium-btn premium-btn-primary" type="submit">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              Add Track
            </button>
          </form>
        </div>
      </section>

      <!-- Materials -->
      <section id="admin-materials" class="admin-section" data-admin-section>
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Course Materials Library</h3>
              <p class="card-subtitle">Upload PDFs, documents, and resources for candidates to download per track.</p>
            </div>
            <form hx-get="/admin" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
              <label class="sr-only" for="matCourseId">Select course</label>
              <select id="matCourseId" name="courseId" class="premium-select" onchange="this.form.requestSubmit()">
                <% courses.forEach(function(course) { %>
                  <option value="<%= course.id %>" <%= selectedCourse && selectedCourse.id === course.id ? "selected" : "" %>><%= course.code %> — <%= course.name %></option>
                <% }) %>
              </select>
            </form>
          </div>

          <form class="flex flex-col gap-4 sm:flex-row sm:items-end" hx-post="/admin/materials/upload" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader" enctype="multipart/form-data">
            <input type="hidden" name="courseId" value="<%= selectedCourse ? selectedCourse.id : "" %>" />
            <div class="flex-1 space-y-2 min-w-0">
              <label class="premium-label">Material title</label>
              <input type="text" name="title" placeholder="e.g. Chapter 1 — Introduction" class="premium-input" />
            </div>
            <div class="flex-1 space-y-2 min-w-0">
              <label class="premium-label">File (PDF, DOC, etc.)</label>
              <input type="file" name="file" class="premium-input file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-brand-700 hover:file:bg-brand-100 file:cursor-pointer" />
            </div>
            <button class="premium-btn premium-btn-primary whitespace-nowrap" type="submit">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
              Upload
            </button>
          </form>

          <% if (selectedCourse && selectedCourse.materials && selectedCourse.materials.length > 0) { %>
            <div class="mt-5 space-y-2">
              <% selectedCourse.materials.forEach(function(mat) { %>
                <div class="flex items-center gap-3 rounded-xl border border-surface-200 bg-white px-4 py-3">
                  <div class="rounded-lg bg-brand-50 p-2 text-brand-600">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-surface-900 truncate"><%= mat.title %></p>
                    <p class="text-xs text-surface-400"><%= mat.filename %> · <%= (mat.filesize / 1024).toFixed(0) %> KB</p>
                  </div>
                  <div class="flex gap-2 flex-shrink-0">
                    <a href="/materials/download/<%= mat.id %>" class="premium-btn premium-btn-ghost text-xs px-3 py-2" aria-label="Download material">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    </a>
                    <form hx-post="/admin/materials/delete/<%= mat.id %>" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader" class="inline">
                      <button class="premium-btn premium-btn-danger text-xs px-3 py-2" type="submit" aria-label="Delete material">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else if (selectedCourse) { %>
            <div class="empty-state mt-5">
              <svg class="h-8 w-8 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <p class="text-sm">No materials uploaded for this track yet.</p>
            </div>
          <% } %>
        </div>
      </section>

      <!-- Question bank -->
      <section id="admin-questions" class="admin-section" data-admin-section>
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">Question Bank</h3>
              <p class="card-subtitle">Edit or replace the question pool for a selected track. Each track needs at least 20 questions.</p>
            </div>
            <form class="flex-shrink-0" hx-get="/admin" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
              <label class="sr-only" for="courseId">Select course</label>
              <select id="courseId" name="courseId" class="premium-select" onchange="this.form.requestSubmit()">
                <% courses.forEach(function(course) { %>
                  <option value="<%= course.id %>" <%= selectedCourse && selectedCourse.id === course.id ? "selected" : "" %>><%= course.code %> — <%= course.name %></option>
                <% }) %>
              </select>
            </form>
          </div>

          <form class="space-y-4" hx-post="/admin/questions" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
            <input type="hidden" name="courseId" value="<%= selectedCourse ? selectedCourse.id : "" %>" />
            <label class="premium-label" for="question-payload">Question payload (JSON array)</label>
            <textarea id="question-payload" name="payload" rows="16" class="w-full rounded-xl border border-surface-700 bg-surface-950 px-4 py-4 font-mono text-sm leading-6 text-emerald-300 outline-none transition placeholder:text-surface-600 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 resize-y"><%= selectedCourse ? JSON.stringify(selectedCourse.questions.map(q => ({
              Question_ID: q.questionId,
              Question_Text: q.text,
              Option_A: q.optionA,
              Option_B: q.optionB,
              Option_C: q.optionC,
              Option_D: q.optionD,
              Correct_Answer: q.correctAnswer
            })), null, 2) : "[]" %></textarea>

            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm text-surface-500">Required fields:
                <code class="text-xs bg-surface-100 px-1.5 py-0.5 rounded font-mono">Question_ID</code>,
                <code class="text-xs bg-surface-100 px-1.5 py-0.5 rounded font-mono">Question_Text</code>,
                <code class="text-xs bg-surface-100 px-1.5 py-0.5 rounded font-mono">Option_A</code>–<code class="text-xs bg-surface-100 px-1.5 py-0.5 rounded font-mono">D</code>,
                <code class="text-xs bg-surface-100 px-1.5 py-0.5 rounded font-mono">Correct_Answer</code>
              </p>
              <div class="flex flex-wrap gap-3">
                <button class="premium-btn premium-btn-primary" type="submit">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                  Commit Payload
                </button>
                <button class="premium-btn premium-btn-secondary" type="button" hx-post="/admin/questions/reset" hx-include="[name='courseId']" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  Reset to Seeds
                </button>
              </div>
            </div>
          </form>
        </div>
      </section>

      <!-- Telemetry -->
      <section id="admin-telemetry" class="admin-section" data-admin-section>
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">System Telemetry</h3>
              <p class="card-subtitle">Current track capacities, pricing, and runtime settings.</p>
            </div>
            <form hx-post="/admin/attempts/reset" hx-target="#admin-stats" hx-swap="innerHTML" hx-indicator="#global-loader">
              <button class="premium-btn premium-btn-danger" type="submit">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Reset Attempt Counter
              </button>
            </form>
          </div>

          <div class="overflow-x-auto scrollbar-thin">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Track</th>
                  <th>Title</th>
                  <th class="text-right">Fee</th>
                  <th class="text-right">Questions</th>
                </tr>
              </thead>
              <tbody>
                <% courses.forEach(function(course) { %>
                  <tr>
                    <td class="font-mono text-xs font-semibold text-surface-700"><%= course.code %></td>
                    <td class="text-surface-700"><%= course.name %></td>
                    <td class="text-right">
                      <% if (course.requiresPayment) { %>
                        <span class="price-pill price-pill-paid"><%= formatNaira(course.priceKobo) %></span>
                      <% } else { %>
                        <span class="badge badge-neutral">Free</span>
                      <% } %>
                    </td>
                    <td class="text-right font-semibold text-surface-900"><%= course._count.questions %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>
