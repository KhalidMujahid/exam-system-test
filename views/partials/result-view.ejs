<%
  var passed = attempt.passed;
  var pct = Number(attempt.percentage) || 0;
  var ringColor = passed ? '#22c55e' : '#ef4444';
%>
<section class="space-y-6 animate-fade-in">
  <div class="flex flex-wrap items-end justify-between gap-3 no-print">
    <div>

      <h2 class="page-head-title">Result Report</h2>
      <p class="page-head-text">A summary of this assessment session. Keep your result code to generate a certificate if you passed.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button class="premium-btn premium-btn-primary sm:w-auto" onclick="window.print()">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        Export PDF
      </button>
      <button class="premium-btn premium-btn-ghost sm:w-auto" hx-get="/portal" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        New Attempt
      </button>
    </div>
  </div>

  <div class="grid gap-5 lg:grid-cols-[1.15fr_1fr]">
    <div class="card">
      <div class="card-header">
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-widest text-brand-600"><%= attempt.course.code %></p>
          <h3 class="card-title truncate"><%= attempt.course.name %></h3>
        </div>
        <span id="outcome-badge" class="badge <%= passed ? 'badge-success' : 'badge-danger' %>"><%= passed ? "PASS" : "FAIL" %></span>
      </div>

      <div class="flex flex-col items-center gap-6 sm:flex-row">
        <div class="score-ring" style="background: conic-gradient(<%= ringColor %> <%= pct %>%, #e2e8f0 0);">
          <div class="text-center">
            <span class="score-ring-value"><%= pct.toFixed(1) %></span>
            <span class="score-ring-label">Percent</span>
          </div>
        </div>

        <div class="grid w-full flex-1 grid-cols-2 gap-3">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-surface-400">Raw score</p>
            <p class="mt-1 text-xl font-bold text-surface-900"><%= attempt.rawScore %> / <%= attempt.totalQuestions %></p>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-surface-400">Outcome</p>
            <p class="mt-1 text-xl font-bold <%= passed ? 'text-accent-600' : 'text-rose-600' %>"><%= passed ? "Passed" : "Failed" %></p>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-surface-400">Questions</p>
            <p class="mt-1 text-xl font-bold text-surface-900"><%= attempt.totalQuestions %></p>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-surface-400">Threshold</p>
            <p class="mt-1 text-xl font-bold text-surface-900">80%</p>
          </div>
        </div>
      </div>

      <% if (!passed) { %>
        <div class="premium-alert premium-alert-error mt-5">
          <svg class="h-5 w-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>The 80% threshold was not met, so a certificate is not available for this result.</span>
        </div>
      <% } else { %>
        <div class="premium-alert premium-alert-success mt-5">
          <svg class="h-5 w-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>You passed. Use the result code below to generate your certificate.</span>
        </div>
      <% } %>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Candidate &amp; session</h3>
          <p class="card-subtitle">Session details recorded on the platform.</p>
        </div>
      </div>

      <div class="grid gap-1">
        <div class="flex justify-between gap-4 py-2.5 border-b border-surface-100">
          <span class="text-xs font-bold uppercase tracking-wider text-surface-500">Participant</span>
          <span class="text-sm font-semibold text-surface-900 text-right"><%= attempt.candidateName %></span>
        </div>
        <div class="flex justify-between gap-4 py-2.5 border-b border-surface-100">
          <span class="text-xs font-bold uppercase tracking-wider text-surface-500">Institution</span>
          <span class="text-sm text-surface-700 text-right"><%= attempt.institution %></span>
        </div>
        <div class="flex justify-between gap-4 py-2.5 border-b border-surface-100">
          <span class="text-xs font-bold uppercase tracking-wider text-surface-500">Started</span>
          <span class="text-xs text-surface-500"><%= attempt.startedAt.toLocaleString("en-GB") %></span>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <span class="text-xs font-bold uppercase tracking-wider text-surface-500">Submitted</span>
          <span class="text-xs text-surface-500"><%= attempt.endedAt ? attempt.endedAt.toLocaleString("en-GB") : "—" %></span>
        </div>
      </div>

      <div class="mt-4 rounded-xl border border-surface-200 bg-surface-50 p-4">
        <div class="flex items-center justify-between gap-3 mb-2">
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <p class="text-xs font-bold uppercase tracking-wider text-surface-500">Result code</p>
          </div>
          <button onclick="copySignature()" class="premium-btn premium-btn-ghost text-xs px-3 py-1.5" title="Copy to clipboard">
            <svg id="copy-icon" class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span id="copy-label">Copy</span>
          </button>
        </div>
        <p id="signature-text" class="break-all font-mono text-xs text-surface-600 bg-white rounded-lg p-3 border border-surface-100 select-all"><%= attempt.checksum || "" %></p>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs italic text-surface-400">Content integrity enforced server-side.</p>
          <div class="flex gap-3">
            <% if (passed) { %>
              <a href="/certificates/generate" hx-get="/certificates/generate" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader" class="text-xs font-semibold text-brand-600 hover:text-brand-700 underline transition">Generate Certificate</a>
            <% } %>
            <a href="/verify" target="_blank" class="text-xs font-semibold text-brand-600 hover:text-brand-700 underline transition">Verify Online</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function copySignature() {
  const text = document.getElementById('signature-text');
  if (!text || !text.textContent) return;
  navigator.clipboard.writeText(text.textContent.trim()).then(() => {
    const icon = document.getElementById('copy-icon');
    const label = document.getElementById('copy-label');
    icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>';
    label.textContent = 'Copied!';
    setTimeout(() => {
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>';
      label.textContent = 'Copy';
    }, 2000);
  }).catch(() => {
    const range = document.createRange();
    range.selectNodeContents(text);
    const selection = window.getSelection();
    selection.removeAllRanges();
    selection.addRange(range);
  });
}
</script>
