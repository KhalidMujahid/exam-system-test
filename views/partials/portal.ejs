<section class="space-y-8 animate-fade-in">
  <div class="page-head">
    <span class="page-head-eyebrow">Candidate Workflow</span>
    <h2 class="page-head-title">Registration &amp; Track Selection</h2>
    <p class="page-head-text">Enter your details and choose a track. Standard assessments are free and start immediately; paid cyber security tracks require a verified payment before the timed session unlocks.</p>
  </div>

  <form id="registration-form" method="POST" action="/checkout" class="space-y-7">
    <div class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Candidate details</h3>
          <p class="card-subtitle">Your details will appear on your assessment record.</p>
        </div>
        <span class="badge badge-neutral">Step 1</span>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <div class="space-y-2">
          <label for="reg-name" class="premium-label">Full name</label>
          <input type="text" name="name" id="reg-name" placeholder="e.g. Inspector John Smith" class="premium-input" autocomplete="name" required />
        </div>
        <div class="space-y-2">
          <label for="reg-email" class="premium-label">Email address</label>
          <input type="email" name="email" id="reg-email" placeholder="e.g. john.smith@example.com" class="premium-input" autocomplete="email" required />
        </div>
        <div class="space-y-2">
          <label for="reg-inst" class="premium-label">Institution / Organisation</label>
          <input type="text" name="institution" id="reg-inst" placeholder="e.g. Metropolitan Police Service" class="premium-input" autocomplete="organization" required />
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Select assessment track</h3>
          <p class="card-subtitle">These courses are free. For paid courses, visit <a class="text-brand-700 underline" href="/certifications">Certifications</a>.</p>
        </div>
        <span class="badge badge-neutral"><%= courses.length %> available</span>
      </div>

      <% if (!courses.length) { %><p class="premium-alert premium-alert-info">No free assessments are available right now. <a href="/certifications" class="underline">Browse certifications</a>.</p><% } %>
      <div class="grid gap-3 lg:grid-cols-2">
        <% courses.forEach(function(course, index) { %>
          <label class="premium-option-label group">
            <input type="radio" name="courseId" value="<%= course.id %>" data-requires-payment="<%= course.requiresPayment ? 'true' : 'false' %>" <%= index === 0 ? "checked" : "" %> class="premium-radio" required />
            <span class="flex-1 min-w-0">
              <span class="block text-sm font-semibold text-surface-900"><%= course.code %> — <%= course.name %></span>
              <span class="block text-xs text-surface-400 mt-0.5"><%= course._count.questions %> questions available</span>
            </span>
            <span class="flex flex-col items-end flex-shrink-0">
              <% if (course.requiresPayment) { %>
                <span class="price-pill price-pill-paid"><%= formatNaira(course.priceKobo) %></span>
                <span class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-surface-400">Cyber security · pay to unlock</span>
              <% } else { %>
                <span class="price-pill price-pill-free">Free</span>
                <span class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-surface-400">Standard · no payment</span>
              <% } %>
            </span>
          </label>
        <% }) %>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-surface-200 bg-surface-50 p-4">
        <div class="flex items-start gap-2.5 text-sm text-surface-500">
          <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>20 questions. <strong class="text-surface-700">80% to pass.</strong> The timer begins when you start.</span>
        </div>
        <button id="portal-submit" class="premium-btn premium-btn-primary" type="submit" <%= !courses.length ? 'disabled' : '' %>>
          <span id="portal-submit-icon" class="inline-flex">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          </span>
          <span id="portal-submit-label">Start assessment</span>
        </button>
      </div>
    </div>
  </form>
</section>
