<%
  var issuedDate = (attempt.certificateIssuedAt || attempt.endedAt || attempt.createdAt);
%>
<section class="space-y-6 animate-fade-in">
  <div class="flex flex-wrap items-center justify-between gap-3 no-print">
    <span class="badge badge-success">
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
      Certificate issued
    </span>
    <div class="flex flex-wrap gap-3">
      <button class="premium-btn premium-btn-primary sm:w-auto" onclick="window.print()">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        Print / Save PDF
      </button>
      <a href="/verify" hx-get="/verify" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader" class="premium-btn premium-btn-ghost sm:w-auto">Verify Online</a>
    </div>
  </div>

  <div class="mx-auto max-w-4xl">
    <div class="cert-frame">
      <div class="cert-inner cert-serif text-center">
        <div class="flex items-center justify-center gap-3">
          <img src="/logo.jpeg" alt="CyberCops Academy" class="h-11 w-11 rounded-xl object-cover ring-1 ring-amber-300/60">
          <div class="text-left">
            <p class="cert-serif text-lg font-bold text-surface-900 leading-tight">CyberCops Academy</p>

          </div>
        </div>

        <div class="cert-rule my-6"></div>

        <h2 class="cert-title">Certificate of Completion</h2>

        <p class="mt-6 text-sm italic text-surface-500">This is to certify that</p>
        <p class="cert-name mt-3"><%= attempt.candidateName %></p>
        <p class="mt-3 text-sm text-surface-500"><%= attempt.institution %></p>

        <p class="mx-auto mt-6 max-w-2xl text-sm leading-relaxed text-surface-600">
          has successfully completed and passed the assessment for
          <strong class="text-surface-900"><%= attempt.course.code %> — <%= attempt.course.name %></strong>,
          meeting the certification standard of CyberCops Academy.
        </p>

        <div class="mt-9 grid grid-cols-1 items-end gap-6 sm:grid-cols-3">
          <div class="text-left">
            <p class="cert-meta-label">Score achieved</p>
            <p class="cert-meta-value mt-1"><%= attempt.rawScore %> / <%= attempt.totalQuestions %> (<%= Number(attempt.percentage).toFixed(1) %>%)</p>
          </div>
          <div class="flex justify-center">
            <div class="cert-seal">
              <div class="cert-seal-inner">Certified<br>CyberCops<br>Academy</div>
            </div>
          </div>
          <div class="text-left sm:text-right">
            <p class="cert-meta-label">Date issued</p>
            <p class="cert-meta-value mt-1"><%= issuedDate.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" }) %></p>
          </div>
        </div>

        <div class="cert-rule my-8"></div>

        <div class="grid gap-8 sm:grid-cols-2">
          <div class="text-left">
            <div class="cert-sign-line">
              <p class="cert-sign-name">CyberCops Academy</p>
              <p class="cert-sign-role">Authorised Certification Body</p>
            </div>
          </div>
          <div class="text-left sm:text-right">
            <p class="cert-meta-label">Result code</p>
            <p class="mt-1 break-all font-mono text-[11px] text-surface-600"><%= attempt.checksum || "" %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-4xl premium-card premium-card-flat no-print">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <p class="text-xs font-bold uppercase tracking-wider text-surface-500">Verified by result code matching against platform records.</p>
      </div>
      <a href="/certificates/generate" hx-get="/certificates/generate" hx-target="#main" hx-swap="innerHTML" hx-indicator="#global-loader" class="text-xs font-semibold text-brand-600 hover:text-brand-700 underline transition">Generate another</a>
    </div>
  </div>
</section>
