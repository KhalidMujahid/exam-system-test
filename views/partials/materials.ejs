<section class="library-page" aria-labelledby="materials-title">
  <div class="page-head"><h2 class="page-head-title" id="materials-title">Course materials</h2><p class="page-head-text">Materials for all courses are free to access. Read, download, and study before taking a paid or free assessment.</p></div>
  <form class="library-filters card" action="/materials" method="get" hx-get="/materials" hx-target="#main" hx-push-url="true" hx-indicator="#global-loader">
    <div><label class="premium-label" for="material-search">Search materials</label><input class="premium-input" id="material-search" type="search" name="q" value="<%= library.q %>" placeholder="Search by title or course" maxlength="200"></div>
    <div><label class="premium-label" for="material-course">Course</label><select class="premium-select" id="material-course" name="courseId"><option value="">All courses</option><% library.courses.forEach(course => { %><option value="<%= course.id %>" <%= library.courseId === course.id ? 'selected' : '' %>><%= course.code %> · <%= course.name %></option><% }) %></select></div>
    <button class="btn btn-primary" type="submit">Search resources</button>
  </form>
  <div class="library-summary"><p role="status"><strong><%= library.total %></strong> <%= library.total === 1 ? 'resource' : 'resources' %><%= library.q || library.courseId ? ' found' : ' available' %></p><% if (library.q || library.courseId) { %><a href="/materials" hx-get="/materials" hx-target="#main" hx-push-url="true">Clear filters</a><% } %><span>Latest additions first</span></div>
  <% if (library.materials.length) { %>
  <div class="resource-grid"><% library.materials.forEach(material => { %>
    <article class="resource-card"><div class="resource-top"><span class="resource-symbol" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5"/></svg></span><span class="badge badge-neutral"><%= material.course.code %></span></div><h3><%= material.title %></h3><p><%= material.course.name %></p><div class="resource-date">Added <%= new Date(material.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></div><div class="resource-actions"><a class="btn btn-secondary" href="/materials/open/<%= material.id %>" target="_blank" rel="noopener noreferrer" aria-label="Open <%= material.title %> (new tab)">Open material ↗</a><a class="resource-download" href="/materials/download/<%= material.id %>" target="_blank" rel="noopener noreferrer" aria-label="Download <%= material.title %> (new tab)">Download ↓</a></div></article>
  <% }) %></div>
  <% } else { %><div class="card library-empty"><h3><%= library.q || library.courseId ? 'No matching materials' : 'Your learning library is on its way' %></h3><p><%= library.q || library.courseId ? 'Try another search term or select a different course.' : 'Course materials will appear here when they are added by the academy.' %></p><a class="btn btn-secondary" href="/materials">Browse all materials</a></div><% } %>
  <% if (library.page > 1 || library.page * 24 < library.total) { %><nav class="library-pagination" aria-label="Materials pages"><% if (library.page > 1) { %><a class="btn btn-secondary" href="/materials?<%= new URLSearchParams({q: library.q, courseId: library.courseId, page: String(library.page - 1)}) %>">Previous</a><% } %><span>Page <%= library.page %></span><% if (library.page * 24 < library.total) { %><a class="btn btn-secondary" href="/materials?<%= new URLSearchParams({q: library.q, courseId: library.courseId, page: String(library.page + 1)}) %>">Next</a><% } %></nav><% } %>
  <p class="library-note">Materials open in a new tab. Downloads and access permissions are managed by the file provider; some resources may open on their website.</p>
</section>
