<section class="overview-page">
  <div class="page-head"><h2 class="page-head-title">Overview</h2><p class="page-head-text">Your home for cybersecurity learning, assessments, and professional certification.</p></div>
  <div class="welcome-panel"><div class="welcome-copy"><h3>Get started</h3><p>Explore your course materials, test your knowledge, and turn your achievement into a certificate.</p><div class="welcome-actions"><a class="btn btn-primary" href="/portal" hx-get="/portal" hx-target="#main" hx-push-url="true">Start an assessment →</a><a class="welcome-secondary" href="/materials" hx-get="/materials" hx-target="#main" hx-push-url="true">Browse materials ↗</a></div></div><div class="journey-panel"><div><span>01</span><p><strong>Prepare at your pace</strong>Explore resources for your course.</p></div><div><span>02</span><p><strong>Complete your assessment</strong>Complete a 20-question assessment.</p></div><div><span>03</span><p><strong>Get your certificate</strong>Score 80% or above to qualify.</p></div></div></div>
  <div class="overview-metrics"><div><strong><%= courses.length %></strong><span>Available courses</span></div><div><strong><%= examDurationMinutes %> <small>min</small></strong><span>Assessment duration</span></div><div><strong>80<small>%</small></strong><span>Passing score</span></div><div><strong><%= attemptCounter %></strong><span>Recorded completions</span></div></div>
  <div class="section-heading"><div><h3>What would you like to do?</h3><p>Everything you need, in one place.</p></div></div>
  <div class="home-actions">
    <% [{path:'/materials', number:'01', title:'Find course materials', text:'Read and download resources to prepare for your assessment.', action:'Explore the library'}, {path:'/certifications',number:'02',title:'Explore certifications',text:'Compare courses and assessment fees before you begin.',action:'View courses'}, {path:'/certificates/generate',number:'03',title:'Get your certificate',text:'Already passed? Use your result code to get your certificate.',action:'Generate certificate'}].forEach(item => { %>
    <a class="home-action" href="<%= item.path %>" hx-get="<%= item.path %>" hx-target="#main" hx-push-url="true"><span class="action-number"><%= item.number %></span><h3><%= item.title %></h3><p><%= item.text %></p><span class="action-link"><%= item.action %> <span aria-hidden="true">→</span></span></a><% }) %>
  </div>
  <div class="verification-strip"><div><strong>Need to verify a result?</strong><p>Check an assessment record using its result code.</p></div><a class="btn btn-secondary" href="/verify" hx-get="/verify" hx-target="#main" hx-push-url="true">Verify a result →</a></div>
</section>
